# QR Service Configuration

# Server
PORT=3001

# Database (PostgreSQL for Outbox Pattern)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qr_service_db
DB_USER=qr_service_user
DB_PASSWORD=qr_pass

# Kafka
KAFKA_BROKERS=localhost:9092,localhost:9093

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:9081

# API Gateway (for service-to-service communication)
# QR Service should call Business Service through API Gateway, not directly
# Gateway provides: service discovery, load balancing, circuit breaker, monitoring
API_GATEWAY_URL=http://localhost:8080

# Keycloak OAuth2 Configuration (for service-to-service authentication)
# QR Service uses Client Credentials Flow to obtain JWT tokens
# ⚠️ IMPORTANT: In production, store client_secret in Kubernetes secrets
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=servemenu-platform
KEYCLOAK_CLIENT_ID=qr-service
KEYCLOAK_CLIENT_SECRET=GolIWEei69RJoWGocoqD5E7szTTRQrNK

# Logging
LOG_LEVEL=info
